rules_version = '2';
// DRAFT 2026-11-26 (Chuck, shared-rules hardening steps 1, 2 and 4; Duane approved 3:39 PM ET) - NOT DEPLOYED. Base: live BW_Youth/firestore.rules (sha256 b2f7ee18, ruleset b01770b2, live 3:28:52 PM ET).
// Changes: (1) the 12 Youth calendar/lesson collections and Ward_events (incl. subcollections): public read stays, writes need bwContentEditor() (leader session or BW_Platform admin).
// (4) mail: create only in the shape the auction pages send (hasOnly to/replyTo/message{subject,html}, one recipient string, size caps); read/update/delete unchanged.
// NOT changed (step 3 is ON HOLD): auction_items, auction_bids, auction_bidders, site_settings/bid_counter, site_settings/item_counter.
// Deploying this is a LIVE production change for every hub.
// DRAFT 2026-11-26 (Chuck, Bish 1.3.15 recommendation date corrections) - NOT DEPLOYED. Base: live BW_Youth/firestore.rules (sha256 aa3fc4ad, ruleset 80965892).
// Changes, callings_recommendations only: (a) new update branch to correct recorded step dates / who while open (step and status unchanged);
// (b) each step date must be on or after the previous recorded step date (steps 2-4, decline, and corrections); (c) archive also allowed for open at step 4.
// Deploying this is a LIVE production change for every hub.
// DRAFT 2026-11-25 (Chuck, Callings Planner, Bish 1.3.0) - NOT DEPLOYED. Base: live BW_Youth/firestore.rules (sha256 d768e3f5, banks).
// Adds (BEGIN/END Callings Planner block): callings_meta, callings_imports (client read-only, admin upload only),
// callings_name_matches, callings_scenarios, callings_recommendations, callings_clerk_packets - read/write only by the
// five General Bishopric seats RC2-RC6 (cpSeats). change_requests: two added allow lines (hand-off create with packet,
// set-apart checkbox); the existing create/update lines are unchanged. Deploying this is a LIVE production change.
// Update 2026-11-25 9:50 PM ET (Bish 1.3.1, Duane): hand-off create also needs handoffKind call|release + mailSubject
// 'Calling change (sustained)'|'Calling change (released)' matching the recommendation type; set apart only on calls (null on releases).
// DRAFT 2026-11-24 (Chuck, member directory phase 4) - NOT DEPLOYED. Base: live BW_Youth/firestore.rules (sha256 b918092e, memberdir).
// Adds: other_names (leaders read/create/update, no client delete); change_requests status update by RC5 or role bishopric/admin;
// optional requesterEmail on create. households/members stay read-only. mail create rule is NOT changed (tighten after auction season).
// Deploying this is a LIVE production change for every hub.
// DRAFT 2026-11-24 (Chuck, member directory phase 3) - NOT DEPLOYED. Base: BW_Youth/firestore.rules (live, sha256 28d6e23e...).
// Only change: new households/{H...}, members/{M...} (LCR-derived names-only directory, strictly read-only for every client)
// and change_requests/{id} (phase 4 'Request a change': leaders create only). Deploying this is a LIVE production change.
// DRAFT 2026-11-23 (Chuck, #2) — NOT DEPLOYED. Base: BW_Youth/firestore.rules (sha256 cc81695b234d…). Only change: browsers can no
// longer write ward_leaders.passwordHash or hasPassword (passkeyApi 1.4.0 owns them). ward_leader_credentials needs no rule:
// with no match block every client read/write is denied. Deploying this is a LIVE production change for every hub.
// DRAFT — NOT DEPLOYED. firestore.rules.draft-20261122-tighten (BW_Platform 0.3.0, built 2026-11-22 ET).
// Base: firestore.rules.release-20261121-2241 (= live ruleset 005abacc, sha256 7388c572…e8e3).
// Changes vs base (Duane voice approval to draft, 12:19 AM ET; deploy needs a separate "Approved"):
//  (1) ward_leaders read is scoped: phone (SMS) sessions read only records whose phoneNumber is their
//      verified number; the full roster is limited to roster readers (RC1-RC6 / admin / bishopric seat,
//      on a passkey session or a bound SMS session) and the BW_Platform admin claim.
//  (2) Home content collections are no longer world-writable: writes need a leader session.
//  (3) New leader_sessions/{uid}: an SMS session binds itself to the one active ward_leaders record
//      whose phoneNumber matches its verified number, so rules can recognise it as that leader.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Leader session helpers (draft 2026-11-22) ----
    function bwProvider() { return request.auth.token.get('firebase', {}).get('sign_in_provider', ''); }
    function bwLeaderPath(id) { return /databases/$(database)/documents/ward_leaders/$(id); }
    function bwSessionPath() { return /databases/$(database)/documents/leader_sessions/$(request.auth.uid); }
    function bwActive(d) { return d.get('active', true) != false; }
    function bwPlatformAdmin() { return request.auth != null && request.auth.token.get('v', 0) == 2 && request.auth.token.get('w', 0) == 1; }
    function bwPhoneSession() {
      return request.auth != null && bwProvider() == 'phone'
        && request.auth.token.get('phone_number', '').matches('^[+]1[0-9]{10}$');
    }
    // Every stored format the hubs have used for a US number, built from the verified E.164 number.
    // Clients query ward_leaders with where('phoneNumber', 'in', <the same 14 strings>).
    function bwPhoneVariants() {
      let p = request.auth.token.phone_number;
      let a = p[2:5];
      let b = p[5:8];
      let c = p[8:12];
      let d = p[2:12];
      return [p, d, '1' + d, '(' + a + ') ' + b + '-' + c, '(' + a + ')' + b + '-' + c,
        a + '-' + b + '-' + c, a + '.' + b + '.' + c, a + ' ' + b + ' ' + c,
        '+1 ' + a + ' ' + b + ' ' + c, '+1 (' + a + ') ' + b + '-' + c, '+1-' + a + '-' + b + '-' + c,
        '+1 ' + a + '-' + b + '-' + c, '1-' + a + '-' + b + '-' + c, '1 (' + a + ') ' + b + '-' + c];
    }
    function bwPhoneMatches(d) { return bwPhoneSession() && d.get('phoneNumber', '') in bwPhoneVariants(); }
    function bwPasskeyLeader() {
      return request.auth != null && bwProvider() == 'custom'
        && exists(bwLeaderPath(request.auth.uid)) && bwActive(get(bwLeaderPath(request.auth.uid)).data);
    }
    function bwBoundLeaderId() { return get(bwSessionPath()).data.get('leaderId', '_none_'); }
    function bwPhoneLeader() {
      return bwPhoneSession() && exists(bwSessionPath())
        && exists(bwLeaderPath(bwBoundLeaderId()))
        && bwActive(get(bwLeaderPath(bwBoundLeaderId())).data)
        && bwPhoneMatches(get(bwLeaderPath(bwBoundLeaderId())).data);
    }
    function bwLeaderSession() { return bwPasskeyLeader() || bwPhoneLeader(); }
    function bwSessionLeaderData() {
      return bwProvider() == 'custom' ? get(bwLeaderPath(request.auth.uid)).data : get(bwLeaderPath(bwBoundLeaderId())).data;
    }
    function bwRosterSeat(d) {
      return d.get('role', '') in ['admin', 'bishopric']
        || (d.get('rcCodes', []) is list && d.get('rcCodes', []).hasAny(['RC1', 'RC2', 'RC3', 'RC4', 'RC5', 'RC6']));
    }
    function bwRosterReader() { return bwPlatformAdmin() || (bwLeaderSession() && bwRosterSeat(bwSessionLeaderData())); }
    function bwContentEditor() { return bwPlatformAdmin() || bwLeaderSession(); }
    function wlPasskeyEditor() { return bwPasskeyLeader() && get(bwLeaderPath(request.auth.uid)).data.get('role', '') in ['admin', 'bishopric']; }

    // Youth calendars and lessons (lock-calendars draft 2026-11-26): public read (org pages, Home calendar), writes need a leader session
    // (passkey, or SMS bound by leader_sessions) or the BW_Platform admin claim. Only the Youth /admin Sync button writes these.
    match /Combined_events/{id} { allow read: if true; allow write: if bwContentEditor(); }
    match /Priests_events/{id} { allow read: if true; allow write: if bwContentEditor(); }
    match /Teachers_events/{id} { allow read: if true; allow write: if bwContentEditor(); }
    match /Deacons_events/{id} { allow read: if true; allow write: if bwContentEditor(); }
    match /YW_events/{id} { allow read: if true; allow write: if bwContentEditor(); }
    match /Primary_events/{id} { allow read: if true; allow write: if bwContentEditor(); }
    
    match /Combined_lessons/{id} { allow read: if true; allow write: if bwContentEditor(); }
    match /Priests_lessons/{id} { allow read: if true; allow write: if bwContentEditor(); }
    match /Teachers_lessons/{id} { allow read: if true; allow write: if bwContentEditor(); }
    match /Deacons_lessons/{id} { allow read: if true; allow write: if bwContentEditor(); }
    match /YW_lessons/{id} { allow read: if true; allow write: if bwContentEditor(); }
    match /Primary_lessons/{id} { allow read: if true; allow write: if bwContentEditor(); }
    
    // Home Page Content (draft 2026-11-22): public read where a public page reads it; writes need a leader session.
    match /home_announcements/{id} { allow read: if true; allow write: if bwContentEditor(); }
    match /home_content/{id} {
      // tithing_declaration_* (schedule with household names/members/emails, and the bishop report): leader sessions only
      // (td draft 2026-11-22). Members move their own appointment through the tdReschedule Function (Admin SDK).
      // bishopric_speaker_bank_v1 and bishopric_prayer_bank_v1 (bank draft 2026-11-24): leader sessions only
      // (they will hold memberId after the map apply). Public pages do not read these two docs.
      allow read: if !id.matches('^(tithing_declaration.*|bishopric_speaker_bank_v1|bishopric_prayer_bank_v1)$') || bwContentEditor();
      allow write: if bwContentEditor();
    }
    // td_public/{year} (td draft 2026-11-22): sanitized /td view (dates, slot times, open/booked, counts; no household,
    // members, email or notes). Written only by the tdReschedule / tdPublicSync Functions (Admin SDK).
    match /td_public/{year} { allow read: if true; allow write: if false; }
    match /home_spotlights/{id} { allow read: if true; allow write: if bwContentEditor(); }
    match /home_teachers/{id} { allow read: if true; allow write: if bwContentEditor(); }
    match /home_leaders/{document=**} { allow read: if true; allow write: if bwContentEditor(); }
    match /teachers/{document=**} { allow read: if true; allow write: if bwContentEditor(); }
    // site_feedback: public pages create feedback (Youth org pages); no client reads it (the Function uses the Admin SDK).
    match /site_feedback/{id} { allow create: if true; allow read, update, delete: if bwContentEditor(); }
    // birthdays: youth names and dates; only Youth admin reads it (birthday-protocol.js is not loaded by any page).
    match /birthdays/{id} { allow read, write: if bwContentEditor(); }

    // Ward Home Page. Ward_events (lock-calendars draft 2026-11-26): public read, writes need a leader session. Only Home /admin writes it.
    match /Ward_events/{document=**} { allow read: if true; allow write: if bwContentEditor(); }
    // ward_leaders (draft 2026-11-22). Read: roster readers (full list); a passkey session its own doc;
    // an SMS session only docs whose phoneNumber is its verified number. Anonymous/email: denied.
    // (google draft 2026-11-22) A Google session with a Google-verified email: only docs whose email equals that email
    // (lower-cased; stored emails are lower-case). Home queries where("email", "==", <lower-cased email>).
    // Create/update: passkey sign-in whose ward_leaders doc has role admin or bishopric, or BW_Platform RC1/RC2.
    // Delete: never from a client (soft-delete policy: set active=false instead).
    match /ward_leaders/{leaderId} {
      allow read: if request.auth != null && (bwRosterReader()
        || (bwProvider() == 'custom' && request.auth.uid == leaderId)
        || (bwPhoneSession() && resource.data.phoneNumber in bwPhoneVariants())
        || (bwProvider() == 'google.com' && request.auth.token.get('email_verified', false) == true
          && request.auth.token.get('email', '') != '' && resource.data.email == request.auth.token.email.lower()));
      allow create: if request.auth != null && (wlPasskeyEditor() || bwPlatformAdmin())
        && !request.resource.data.keys().hasAny(['passwordHash', 'hasPassword']);
      allow update: if request.auth != null && (wlPasskeyEditor() || bwPlatformAdmin())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['passwordHash', 'hasPassword']);
      allow delete: if false;
      match /{sub=**} {
        // {sub=**} also matches the ward_leaders doc itself (zero segments), so the same password-field guard is needed here.
        allow read: if request.auth != null && bwRosterReader();
        allow create: if request.auth != null && (wlPasskeyEditor() || bwPlatformAdmin())
          && !request.resource.data.keys().hasAny(['passwordHash', 'hasPassword']);
        allow update: if request.auth != null && (wlPasskeyEditor() || bwPlatformAdmin())
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['passwordHash', 'hasPassword']);
        allow delete: if false;
      }
    }
    // leader_sessions (draft 2026-11-22): written by the SMS session itself, only for a matching active leader.
    match /leader_sessions/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && bwPhoneSession()
        && request.resource.data.keys().hasOnly(['leaderId', 'boundAt', 'hub'])
        && request.resource.data.leaderId is string
        && request.resource.data.leaderId.matches('^[A-Za-z0-9_-]{1,128}$')
        && exists(bwLeaderPath(request.resource.data.leaderId))
        && bwActive(get(bwLeaderPath(request.resource.data.leaderId)).data)
        && bwPhoneMatches(get(bwLeaderPath(request.resource.data.leaderId)).data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // BEGIN ward_permissions_* (lookup draft 2026-11-21; claims draft needs a Functions change and is not included).
    // Signed-in read of roles and meta; history read is RC1/RC2 editors only (as in the draft).
    // Write on roles/meta: active passkey leader with RC1 or RC2. History create-only. No deletes.
    function wpLeaderPath() { return /databases/$(database)/documents/ward_leaders/$(request.auth.uid); }
    function wpProvider() { return request.auth.token.get('firebase', {}).get('sign_in_provider', ''); }
    function wpLeaderData() { return get(wpLeaderPath()).data; }
    function wpHasSeat(d, seat) { return d.get('rcCodes', []) is list && seat in d.get('rcCodes', []); }
    function wpIsLeaderDoc() {
      return request.auth != null && exists(wpLeaderPath())
        && wpLeaderData().get('active', true) != false;
    }
    // Passkey sign-in = custom token whose uid is the leader doc id; only RC1/RC2 may edit.
    function wpEditor() {
      return request.auth != null
        && wpProvider() == 'custom'
        && wpIsLeaderDoc()
        && (wpHasSeat(wpLeaderData(), 'RC1') || wpHasSeat(wpLeaderData(), 'RC2'));
    }
    match /ward_permissions_roles/{rc} {
      allow read: if request.auth != null;
      allow create, update: if wpEditor()
        && rc.matches('^RC[0-9]+$')
        && request.resource.data.get('rc', '') == rc
        && request.resource.data.get('schemaVersion', 0) == 1
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() > 0
        && request.resource.data.get('name', '').size() < 200
        && request.resource.data.get('label', '') is string
        && request.resource.data.get('label', '').size() < 80
        && request.resource.data.get('org', []) is list
        && request.resource.data.get('areas', null) is list
        && request.resource.data.get('active', true) is bool;
      allow delete: if false;
    }
    match /ward_permissions_meta/{id} {
      allow read: if request.auth != null;
      allow create, update: if wpEditor() && id == 'current'
        && request.resource.data.get('schemaVersion', 1) == 1
        && request.resource.data.get('roleCount', 0) is int
        && request.resource.data.get('roleIds', []) is list;
      allow delete: if false;
    }
    match /ward_permissions_history/{id} {
      allow read: if wpEditor();
      allow create: if wpEditor()
        && request.resource.data.get('action', '') in ['import', 'update', 'add', 'retire']
        && request.resource.data.get('schemaVersion', 1) is int;
      allow update, delete: if false;
    }
    // END ward_permissions_*
  
    // NEW AUCTION SITE RULES
    match /auction_items/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /auction_bids/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /auction_bidders/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    // mail (lock-calendars draft 2026-11-26): the public auction pages still create mail docs (Trigger Email extension), but only in
    // the exact shape they send today: {to, [replyTo], message:{subject, html}}, one recipient, size-capped. Read/update/delete unchanged.
    function bwMailAddr(v) { return v is string && v.size() >= 3 && v.size() <= 254 && v.matches('^[^@\\s,;<>]+@[^@\\s,;<>]+$'); }
    function bwMailShape(d) {
      return d.keys().hasOnly(['to', 'replyTo', 'message'])
        && d.keys().hasAll(['to', 'message'])
        && bwMailAddr(d.to)
        && (!('replyTo' in d) || bwMailAddr(d.replyTo))
        && d.message is map
        && d.message.keys().hasOnly(['subject', 'html'])
        && d.message.keys().hasAll(['subject', 'html'])
        && d.message.subject is string && d.message.subject.size() >= 1 && d.message.subject.size() <= 500
        && d.message.html is string && d.message.html.size() >= 1 && d.message.html.size() <= 20000;
    }
    match /mail/{document} {
      allow create: if bwMailShape(request.resource.data);
      allow read, update, delete: if request.auth != null;
    }
    match /site_settings/bid_counter {
      allow read, write: if true;
    }
    match /site_settings/item_counter {
      allow read, write: if request.auth != null;
          }
    // ---- Member directory (draft 2026-11-24, phase 3) ----
    // LCR-derived, names only. Data flows one way: LCR -> offline master -> local admin sync script -> here.
    // Read: signed-in leaders (BW_Platform admin claim or a leader session, same as bwContentEditor()).
    // Write: NEVER from any client (no site UI edits these, including `active`). Only the admin SDK sync writes.
    // {sub=**} also matches the parent doc itself (zero segments), so the deny is repeated there.
    match /households/{householdId} {
      allow read: if request.auth != null && bwContentEditor();
      allow write: if false;
      match /{sub=**} {
        allow read: if request.auth != null && bwContentEditor();
        allow write: if false;
      }
    }
    match /members/{memberId} {
      allow read: if request.auth != null && bwContentEditor();
      allow write: if false;
      match /{sub=**} {
        allow read: if request.auth != null && bwContentEditor();
        allow write: if false;
      }
    }
    // change_requests (phase 4 'Request a change'): a leader proposes a correction; the Ward Clerk makes it in LCR.
    // Create only, by a signed-in leader, as themselves, status 'open', fixed fields. No client update/delete yet
    // (clerk status workflow and notification TBD in phase 4). No subcollections.
    function bwCanCloseChangeRequest() {
      return bwPlatformAdmin() || (bwLeaderSession() && (
        bwSessionLeaderData().get('role', '') in ['bishopric', 'admin']
        || (bwSessionLeaderData().get('rcCodes', []) is list && 'RC5' in bwSessionLeaderData().get('rcCodes', []))
      ));
    }
    match /change_requests/{requestId} {
      allow read: if request.auth != null && bwContentEditor();
      allow create: if request.auth != null && bwContentEditor()
        && request.resource.data.keys().hasOnly(['targetType', 'targetId', 'proposedChange', 'requesterUid', 'requesterName', 'requesterEmail', 'createdAt', 'status'])
        && request.resource.data.keys().hasAll(['targetType', 'targetId', 'proposedChange', 'requesterUid', 'createdAt', 'status'])
        && request.resource.data.targetType in ['household', 'member']
        && request.resource.data.targetId is string && request.resource.data.targetId.matches('^(H[0-9]{4}|M[0-9]{5})$')
        && request.resource.data.proposedChange is string && request.resource.data.proposedChange.size() > 0 && request.resource.data.proposedChange.size() <= 2000
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'open'
        && (!request.resource.data.keys().hasAny(['requesterEmail']) || (request.resource.data.requesterEmail is string && request.resource.data.requesterEmail.size() < 200));
      allow update: if request.auth != null && bwCanCloseChangeRequest()
        && resource.data.status == 'open'
        && request.resource.data.status in ['done_lcr', 'declined']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolutionNote', 'resolvedBy', 'resolvedAt'])
        && request.resource.data.resolvedBy == request.auth.uid;
      // Callings Planner hand-off (draft 2026-11-25): same Clerk flow + email, created with its packet in one batch.
      allow create: if request.auth != null && cpUser()
        && request.resource.data.keys().hasOnly(['targetType', 'targetId', 'proposedChange', 'requesterUid', 'requesterName', 'requesterEmail', 'createdAt', 'status', 'handoff', 'packetId', 'setApart', 'handoffKind', 'mailSubject'])
        && request.resource.data.keys().hasAll(['targetType', 'targetId', 'proposedChange', 'requesterUid', 'createdAt', 'status', 'handoff', 'packetId', 'setApart', 'handoffKind', 'mailSubject'])
        && request.resource.data.handoff == 'callings'
        // 1.3.1: calls and releases both hand off; kind and subject follow the recommendation type; set apart is N/A (null) for releases.
        && ((request.resource.data.handoffKind == 'call' && request.resource.data.mailSubject == 'Calling change (sustained)' && request.resource.data.setApart == false
              && get(cpPath('callings_recommendations', request.resource.data.packetId)).data.type == 'Approved to call to new calling')
          || (request.resource.data.handoffKind == 'release' && request.resource.data.mailSubject == 'Calling change (released)' && request.resource.data.setApart == null
              && get(cpPath('callings_recommendations', request.resource.data.packetId)).data.type == 'Approved to release member from calling'))
        && request.resource.data.targetType == 'member'
        && request.resource.data.targetId is string && request.resource.data.targetId.matches('^M[0-9]{5}$')
        && request.resource.data.proposedChange is string && request.resource.data.proposedChange.size() > 0 && request.resource.data.proposedChange.size() <= 2000
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'open'
        && (!request.resource.data.keys().hasAny(['requesterEmail']) || (request.resource.data.requesterEmail is string && request.resource.data.requesterEmail.size() < 200))
        && request.resource.data.packetId is string
        && getAfter(cpPath('callings_clerk_packets', request.resource.data.packetId)).data.changeRequestId == requestId;
      // Set-apart checkbox on a hand-off (the Clerk, or anyone in the General Bishopric).
      allow update: if request.auth != null && (bwCanCloseChangeRequest() || cpUser())
        && resource.data.get('handoff', '') == 'callings' && resource.data.get('handoffKind', '') == 'call'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['setApart', 'setApartAt', 'setApartBy'])
        && request.resource.data.setApart is bool
        && request.resource.data.setApartBy == request.auth.uid && request.resource.data.setApartAt == request.time;
      allow delete: if false;
    }
    // other_names: free-typed outside names. Leaders may create and update; no client deletes.
    // {sub=**} also matches the parent doc itself (zero segments), so the same grants are repeated there.
    match /other_names/{nameKey} {
      allow read: if request.auth != null && bwContentEditor();
      allow create: if request.auth != null && bwContentEditor()
        && nameKey == request.resource.data.nameKey
        && request.resource.data.keys().hasOnly(['name', 'nameKey', 'note', 'firstUsedAt', 'lastUsedAt', 'useCount', 'usedIn', 'linkedMemberId', 'createdBy', 'updatedBy'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.nameKey is string && request.resource.data.nameKey.size() > 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.useCount is int && request.resource.data.useCount == 1
        && request.resource.data.linkedMemberId == null;
      allow update: if request.auth != null && bwContentEditor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastUsedAt', 'useCount', 'usedIn', 'note', 'updatedBy', 'linkedMemberId'])
        && request.resource.data.name == resource.data.name
        && request.resource.data.nameKey == resource.data.nameKey
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.useCount is int && request.resource.data.useCount >= resource.data.useCount
        && (request.resource.data.linkedMemberId == resource.data.linkedMemberId
          || (bwPlatformAdmin() && (request.resource.data.linkedMemberId == null || request.resource.data.linkedMemberId is string)));
      allow delete: if false;
      match /{sub=**} {
        // {sub=**} also matches the other_names doc itself (zero segments). Writes are decided on the parent match
        // so a loose create here cannot bypass the nameKey == doc id guard. Subcollections: no client writes.
        allow read: if request.auth != null && bwContentEditor();
        allow write: if false;
      }
    }
    // BEGIN Callings Planner (draft 2026-11-25, Chuck, Bish 1.3.0) ----
    // General Bishopric only: the five Bishopric hub seats. Keep this list identical to
    // CALLINGS_PLANNER_SEATS in BW_Bish/public/js/callings-core.js and tests/27-callings-planner.test.js.
    // Bishop RC2, 1st Counselor RC3, 2nd Counselor RC4, Ward Clerk RC5, Executive Secretary RC6.
    // Session must be a leader session (passkey, or SMS bound via leader_sessions). No role fallback,
    // no platform-admin claim, no org leaders, no Music Coordinator.
    function cpSeats() { return ['RC2', 'RC3', 'RC4', 'RC5', 'RC6']; }
    function cpUser() {
      return request.auth != null && bwLeaderSession()
        && bwSessionLeaderData().get('rcCodes', []) is list
        && bwSessionLeaderData().get('rcCodes', []).hasAny(cpSeats());
    }
    function cpPath(col, id) { return /databases/$(database)/documents/$(col)/$(id); }
    function cpDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function cpRosterId(v) { return v is string && v.matches('^[a-z][a-z0-9_]{1,40}$'); }
    function cpCurrentImport() { return get(cpPath('callings_meta', 'current')).data.importId; }
    function cpIsCall(d) { return d.type == 'Approved to call to new calling'; }
    function cpOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    // 1.3.15: date corrections. Dates are cpDate strings (YYYY-MM-DD), so string comparison is date comparison.
    // 'let' bindings keep the expression count low (Firestore rules stop at 1000 expressions per request).
    function cpRecOrdered(d) {
      let a = d.get('agreedAt', '');
      let e = d.get('extendedAt', '');
      let c = d.get('acceptedAt', '');
      let p = d.get('pulpitAt', '');
      return (a == '' || e == '' || a <= e) && (e == '' || c == '' || e <= c) && (c == '' || p == '' || c <= p) && (c != '' || e == '' || p == '' || e <= p);
    }
    // Correction of already-recorded dates / who. The branch itself pins status, step and the allowed keys (cpOnly); here: no key added,
    // every already-recorded date / who still well-formed (a removed field fails too), and the whole chain in order.
    function cpRecCorrectionOk() {
      let d = request.resource.data;
      let r = resource.data;
      return d.keys().hasOnly(r.keys())
        && (!('agreedAt' in r) || cpDate(d.get('agreedAt', ''))) && (!('extendedAt' in r) || cpDate(d.get('extendedAt', '')))
        && (!('acceptedAt' in r) || cpDate(d.get('acceptedAt', ''))) && (!('pulpitAt' in r) || cpDate(d.get('pulpitAt', '')))
        && (!('parentApprovalAt' in r) || cpDate(d.get('parentApprovalAt', '')))
        && (!('extenderId' in r) || cpRosterId(d.get('extenderId', ''))) && (!('conductorId' in r) || cpRosterId(d.get('conductorId', '')))
        && cpRecOrdered(d);
    }
    function cpStamped() { return request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time; }

    // Read-only imported snapshot + current pointer. Only the offline upload script (admin) writes.
    match /callings_meta/{id} {
      allow read: if cpUser();
      allow write: if false;
    }
    match /callings_imports/{importId} {
      allow read: if cpUser();
      allow write: if false;
      match /{sub=**} {
        allow read: if cpUser();
        allow write: if false;
      }
    }
    // Manual name matches from the unmatched queue (reused by the next offline import).
    match /callings_name_matches/{nameKey} {
      allow read: if cpUser();
      allow create, update: if cpUser()
        && nameKey.matches('^[a-z0-9-]{1,120}$')
        && request.resource.data.keys().hasOnly(['nameKey', 'memberId', 'method', 'needsReview', 'matchedBy', 'matchedAt', 'importId'])
        && request.resource.data.nameKey == nameKey
        && request.resource.data.memberId is string && request.resource.data.memberId.matches('^M[0-9]{5}$')
        && request.resource.data.method == 'manual' && request.resource.data.needsReview == false
        && request.resource.data.matchedBy == request.auth.uid && request.resource.data.matchedAt == request.time
        && request.resource.data.importId is string;
      allow delete: if cpUser();
    }
    // What-if scenarios (moves only; never touch the snapshot). 'stale' is set only by the upload script;
    // a user clears it by rebasing on the current import. Archived scenarios are frozen, then purged.
    function cpScenarioShape(d) {
      return d.keys().hasOnly(['name', 'basedOnImportId', 'status', 'staleConflicts', 'staleAt', 'staleImportId', 'moves', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'archivedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.moves is list && d.moves.size() <= 200
        && d.basedOnImportId is string
        && d.status in ['draft', 'active', 'stale', 'archived'];
    }
    function cpSameStale() {
      return request.resource.data.get('staleConflicts', null) == resource.data.get('staleConflicts', null)
        && request.resource.data.get('staleAt', null) == resource.data.get('staleAt', null)
        && request.resource.data.get('staleImportId', null) == resource.data.get('staleImportId', null);
    }
    match /callings_scenarios/{sid} {
      allow read: if cpUser();
      allow create: if cpUser() && cpScenarioShape(request.resource.data) && cpStamped()
        && request.resource.data.status in ['draft', 'active']
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.basedOnImportId == cpCurrentImport()
        && !request.resource.data.keys().hasAny(['staleConflicts', 'staleAt', 'staleImportId', 'archivedAt']);
      allow update: if cpUser() && cpScenarioShape(request.resource.data) && cpStamped()
        && resource.data.status != 'archived'
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (request.resource.data.status in ['draft', 'active', 'stale']
            && (request.resource.data.status == resource.data.status
              || (resource.data.status in ['draft', 'active'] && request.resource.data.status in ['draft', 'active']))
            && request.resource.data.basedOnImportId == resource.data.basedOnImportId && cpSameStale())
          || (resource.data.status == 'stale' && request.resource.data.status == 'active'
            && request.resource.data.basedOnImportId == cpCurrentImport()
            && request.resource.data.get('staleConflicts', []) == [])
          || (request.resource.data.status == 'archived' && request.resource.data.archivedAt == request.time)
        );
      allow delete: if cpUser() && resource.data.status == 'archived';
    }
    // Recommendations: exact labels only; four steps, each with a date and who. No notes or free text.
    match /callings_recommendations/{rid} {
      allow read: if cpUser();
      allow create: if cpUser() && cpStamped()
        && request.resource.data.keys().hasOnly(['scenarioId', 'type', 'memberId', 'callingId', 'relatedRecommendationId', 'youth', 'basedOnImportId', 'status', 'step', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && request.resource.data.type in ['Approved to call to new calling', 'Approved to release member from calling']
        && request.resource.data.memberId is string && request.resource.data.memberId.matches('^M[0-9]{5}$')
        && request.resource.data.callingId is string && request.resource.data.callingId.matches('^CL[0-9]{4,6}$')
        && request.resource.data.scenarioId is string && exists(cpPath('callings_scenarios', request.resource.data.scenarioId))
        && request.resource.data.status == 'open' && request.resource.data.step == 0
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if cpUser() && cpStamped() && (
        // 1) the bishop and both counselors unanimously agree
        (resource.data.status == 'open' && resource.data.step == 0 && request.resource.data.step == 1
          && cpOnly(['step', 'agreedAt', 'agreedByBishop', 'agreedByCounselor1', 'agreedByCounselor2', 'updatedAt', 'updatedBy'])
          && cpDate(request.resource.data.agreedAt)
          && request.resource.data.agreedByBishop == true && request.resource.data.agreedByCounselor1 == true
          && request.resource.data.agreedByCounselor2 == true)
        // 2) an assigned bishopric member extends the call or release
        || (resource.data.status == 'open' && resource.data.step == 1 && request.resource.data.step == 2
          && cpOnly(['step', 'extendedAt', 'extenderId', 'updatedAt', 'updatedBy'])
          && cpDate(request.resource.data.extendedAt) && cpRosterId(request.resource.data.extenderId)
          && cpRecOrdered(request.resource.data))
        // 3) calls only: the member accepts
        || (resource.data.status == 'open' && resource.data.step == 2 && request.resource.data.step == 3 && cpIsCall(resource.data)
          && cpOnly(['step', 'acceptedAt', 'updatedAt', 'updatedBy']) && cpDate(request.resource.data.acceptedAt)
          && cpRecOrdered(request.resource.data))
        // 3) calls only: the member declines -> stopped (no pulpit, no clerk)
        || (resource.data.status == 'open' && resource.data.step == 2 && cpIsCall(resource.data)
          && request.resource.data.status == 'declined'
          && cpOnly(['status', 'declinedAt', 'updatedAt', 'updatedBy']) && cpDate(request.resource.data.declinedAt)
          && request.resource.data.declinedAt >= resource.data.get('extendedAt', ''))
        // 4) released / sustained over the pulpit by the conducting bishopric member
        || (resource.data.status == 'open' && request.resource.data.step == 4
          && ((cpIsCall(resource.data) && resource.data.step == 3) || (!cpIsCall(resource.data) && resource.data.step == 2))
          && cpOnly(['step', 'pulpitAt', 'conductorId', 'updatedAt', 'updatedBy'])
          && cpDate(request.resource.data.pulpitAt) && cpRosterId(request.resource.data.conductorId)
          && cpRecOrdered(request.resource.data))
        // youth calls: parent/guardian approval is a date only
        || (resource.data.status == 'open'
          && cpOnly(['parentApprovalAt', 'updatedAt', 'updatedBy']) && cpDate(request.resource.data.parentApprovalAt))
        // 1.3.15 correct recorded dates / who (open, before the clerk hand-off): step and status unchanged, only already-recorded fields, whole chain in order
        || (resource.data.status == 'open' && request.resource.data.status == 'open' && request.resource.data.step == resource.data.step
          && cpOnly(['agreedAt', 'extendedAt', 'extenderId', 'acceptedAt', 'pulpitAt', 'conductorId', 'parentApprovalAt', 'updatedAt', 'updatedBy'])
          && cpRecCorrectionOk())
        // clerk hand-off: only after step 4, in the same batch as callings_clerk_packets/{rid}
        || (resource.data.status == 'open' && resource.data.step == 4 && request.resource.data.status == 'awaiting_confirmation'
          && cpOnly(['status', 'clerkPacketId', 'clerkHandoffAt', 'updatedAt', 'updatedBy'])
          && request.resource.data.clerkPacketId == rid && request.resource.data.clerkHandoffAt == request.time
          && existsAfter(cpPath('callings_clerk_packets', rid)))
        // archive: finished, or abandoned while open (1.3.15: also at step 4, before the hand-off)
        || ((resource.data.status in ['declined', 'confirmed', 'diverged'] || resource.data.status == 'open')
          && request.resource.data.status == 'archived'
          && cpOnly(['status', 'archivedAt', 'updatedAt', 'updatedBy']) && request.resource.data.archivedAt == request.time)
      );
      allow delete: if cpUser() && resource.data.status == 'archived';
    }
    // Clerk hand-off packet: one per recommendation (doc id = recommendation id), only after step 4.
    // Confirmed / diverged is recorded on the recommendation by the next import (upload script).
    match /callings_clerk_packets/{rid} {
      allow read: if cpUser();
      allow create: if cpUser()
        && request.resource.data.keys().hasOnly(['recommendationId', 'generatedAt', 'generatedBy', 'payload', 'changeRequestId', 'status'])
        && request.resource.data.recommendationId == rid
        && request.resource.data.generatedBy == request.auth.uid && request.resource.data.generatedAt == request.time
        && request.resource.data.status == 'ready' && request.resource.data.payload is map
        && request.resource.data.changeRequestId is string
        && get(cpPath('callings_recommendations', rid)).data.status == 'open'
        && get(cpPath('callings_recommendations', rid)).data.step == 4
        && getAfter(cpPath('callings_recommendations', rid)).data.status == 'awaiting_confirmation'
        && existsAfter(cpPath('change_requests', request.resource.data.changeRequestId));
      allow update, delete: if false;
    }
    // Temporary and custom assignments (Bish 1.3.13). NOT LCR callings.
    // Same General Bishopric seats as the rest of the planner (cpUser / RC2-RC6).
    // DRAFT ONLY — do not deploy until Duane gives a separate rules approval.
    // A rules deploy is a live production change for every hub on blackstoneward-b861c.
    function cpAssignmentKeys() {
      return ['type', 'orgKey', 'orgId', 'callingId', 'title', 'note', 'memberId', 'status', 'endDate', 'endReason', 'basedOnImportId', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'endedAt', 'endedBy', 'thankYouStatus', 'thankYouAt', 'thankedAt', 'thankedBy', 'dismissedAt', 'dismissedBy', 'filledByImportId', 'filledByMemberId'];
    }
    function cpAssignmentShape(d) {
      return d.keys().hasOnly(cpAssignmentKeys())
        && d.type in ['vacantFill', 'custom']
        && d.orgKey is string && d.orgKey.size() > 0 && d.orgKey.size() <= 80
        && (d.orgId == null || d.orgId is int)
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && (d.note == null || (d.note is string && d.note.size() <= 400))
        && (d.memberId == null || (d.memberId is string && d.memberId.matches('^M[0-9]{5}$')))
        && d.status in ['active', 'ended', 'deleted']
        && (d.endDate == null || cpDate(d.endDate))
        && (d.endReason == null || d.endReason in ['removed', 'lcrFilled', 'deleted'])
        && d.basedOnImportId is string
        && ((d.type == 'vacantFill' && d.callingId is string && d.callingId.size() > 0 && d.callingId.size() <= 80)
          || (d.type == 'custom' && d.callingId == null))
        && (d.thankYouStatus == null || d.thankYouStatus in ['pending', 'thanked', 'dismissed'])
        && (d.filledByImportId == null || d.filledByImportId is string)
        && (d.filledByMemberId == null || (d.filledByMemberId is string && d.filledByMemberId.matches('^M[0-9]{5}$')));
    }
    function cpAssignmentIdentityLocked() {
      return request.resource.data.type == resource.data.type
        && request.resource.data.orgKey == resource.data.orgKey
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.callingId == resource.data.callingId
        && request.resource.data.title == resource.data.title
        && request.resource.data.basedOnImportId == resource.data.basedOnImportId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
    }
    match /callings_assignments/{aid} {
      allow read: if cpUser();
      allow create: if cpUser() && cpAssignmentShape(request.resource.data) && cpStamped()
        && request.resource.data.status == 'active'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.basedOnImportId == cpCurrentImport()
        && request.resource.data.endReason == null
        && request.resource.data.endedAt == null
        && request.resource.data.endedBy == null
        && request.resource.data.thankYouStatus == null
        && request.resource.data.thankYouAt == null
        && request.resource.data.thankedAt == null
        && request.resource.data.thankedBy == null
        && request.resource.data.dismissedAt == null
        && request.resource.data.dismissedBy == null
        && request.resource.data.filledByImportId == null
        && request.resource.data.filledByMemberId == null;
      allow update: if cpUser() && cpAssignmentShape(request.resource.data) && cpStamped()
        && cpAssignmentIdentityLocked()
        && (
          // Active edits: assign, unassign, or change note/end date. Soft fields stay unset.
          (resource.data.status == 'active' && request.resource.data.status == 'active'
            && request.resource.data.endReason == null
            && request.resource.data.endedAt == null && request.resource.data.endedBy == null
            && request.resource.data.thankYouStatus == null
            && request.resource.data.thankYouAt == null
            && request.resource.data.thankedAt == null && request.resource.data.thankedBy == null
            && request.resource.data.dismissedAt == null && request.resource.data.dismissedBy == null
            && request.resource.data.filledByImportId == null && request.resource.data.filledByMemberId == null)
          // End a vacantFill (Remove, or auto-end when a later LCR import fills the calling).
          || (resource.data.status == 'active' && request.resource.data.status == 'ended'
            && request.resource.data.endedBy == request.auth.uid
            && request.resource.data.endedAt == request.time
            && request.resource.data.endReason in ['removed', 'lcrFilled']
            && (
              (request.resource.data.endReason == 'removed'
                && request.resource.data.thankYouStatus == null
                && request.resource.data.thankYouAt == null
                && request.resource.data.filledByImportId == null
                && request.resource.data.filledByMemberId == null
                && request.resource.data.thankedAt == null && request.resource.data.thankedBy == null
                && request.resource.data.dismissedAt == null && request.resource.data.dismissedBy == null)
              || (request.resource.data.endReason == 'lcrFilled'
                && request.resource.data.thankYouStatus == 'pending'
                && request.resource.data.thankYouAt == request.time
                && request.resource.data.filledByImportId is string
                && request.resource.data.thankedAt == null && request.resource.data.thankedBy == null
                && request.resource.data.dismissedAt == null && request.resource.data.dismissedBy == null)
            ))
          // Soft delete a custom assignment (status 'deleted'; client delete is denied).
          || (resource.data.status == 'active' && request.resource.data.status == 'deleted'
            && request.resource.data.type == 'custom'
            && request.resource.data.endReason == 'deleted'
            && request.resource.data.endedBy == request.auth.uid
            && request.resource.data.endedAt == request.time)
          // Mark a thank-you follow-up thanked or dismissed.
          || (resource.data.status == 'ended' && request.resource.data.status == 'ended'
            && resource.data.endReason == 'lcrFilled' && request.resource.data.endReason == 'lcrFilled'
            && resource.data.thankYouStatus == 'pending'
            && request.resource.data.memberId == resource.data.memberId
            && request.resource.data.endedAt == resource.data.endedAt
            && request.resource.data.endedBy == resource.data.endedBy
            && request.resource.data.thankYouAt == resource.data.thankYouAt
            && request.resource.data.filledByImportId == resource.data.filledByImportId
            && request.resource.data.filledByMemberId == resource.data.filledByMemberId
            && (
              (request.resource.data.thankYouStatus == 'thanked'
                && request.resource.data.thankedBy == request.auth.uid
                && request.resource.data.thankedAt == request.time
                && request.resource.data.dismissedAt == null && request.resource.data.dismissedBy == null)
              || (request.resource.data.thankYouStatus == 'dismissed'
                && request.resource.data.dismissedBy == request.auth.uid
                && request.resource.data.dismissedAt == request.time
                && request.resource.data.thankedAt == null && request.resource.data.thankedBy == null)
            ))
        );
      // No client delete: Remove / Delete set status 'ended' or 'deleted' so a short history remains.
      allow delete: if false;
    }

    // END Callings Planner ----
   match /site_settings/{document=**} { 
      allow read: if true;
      allow write: if false;
    }
  }
}
