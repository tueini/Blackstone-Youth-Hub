{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "target": "staging",
      "public": "public",
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/.agents/**",
        "**/*.md",
        "**/*.bak",
        "**/*.log",
        "**/*.orig",
        "**/*~"
      ]
    },
    {
      "target": "youth",
      "public": "public",
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/.agents/**",
        "**/*.md",
        "**/*.bak",
        "**/*.log",
        "**/*.orig",
        "**/*~"
      ]
    }
  ],
  "functions": {
    "source": "functions"
  }
}